const rsvpText = "Assalamu Alaikum / Hello Al Hikmah Stationery! I'll be attending the Grand Opening on Sunday, 29 November 2026 at 4:00 PM.";
const waRsvp = `https://wa.me/${WA}?text=${encodeURIComponent(rsvpText)}`;
const gcal =
