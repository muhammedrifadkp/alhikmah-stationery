const SITE = 'https://alhikmah-stationery.vercel.app';
const WA = '971503997597';
const LAT = 25.3714104;
const LNG = 55.4025383;

async function set(src: ImageMetadata, widths: number[], format: 'avif' | 'webp' | 'jpeg') {
  const imgs = await Promise.all(
    widths.map((w) => getImage({ src, width: w, format, quality: format === 'avif' ? 60 : 78 }))
  );
  return imgs.map((i, n) => `${i.src} ${widths[n]}w`).join(', ');
}

async function pic(src: ImageMetadata, widths: number[]) {
  const fallback = await getImage({ src, width: widths[widths.length - 1], format: 'jpeg', quality: 82 });
  return {
    avif: await set(src, widths, 'avif'),
    webp: await set(src, widths, 'webp'),
    jpg: fallback.src,
  };
}

const heroBgPic = await pic(heroWide, [960, 1440, 1920]);
const heroCardPic = await pic(heroTall, [540, 820, 1080]);
const hospPic = await pic(openingHospitality, [480, 760, 1080]);
