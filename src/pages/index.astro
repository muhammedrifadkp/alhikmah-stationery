const mapPlace = `https://www.google.com/maps/place/25%C2%B022'17.1%22N+55%C2%B024'09.1%22E/@${LAT},${LNG},17z`;
const mapEmbed = `https://maps.google.com/maps?q=${LAT},${LNG}&z=16&hl=en&output=embed`;
---
