---
import { getImage } from 'astro:assets';
import '../styles/site.css';

import heroWide from '../assets/img/hero-light-wide.jpg';
import heroTall from '../assets/img/hero-light-tall.jpg';
import boutiqueInterior from '../assets/img/boutique-interior.jpg';
import openingHospitality from '../assets/img/opening-hospitality.jpg';
import deptStationery from '../assets/img/dept-stationery-v2.jpg';
import deptOffice from '../assets/img/dept-office-v2.jpg';
import deptPrinting from '../assets/img/dept-printing-v2.jpg';
import deptGifts from '../assets/img/dept-gifts-v2.jpg';
import galleryCalligraphy from '../assets/img/gallery-calligraphy.jpg';
import galleryStudio from '../assets/img/gallery-studio.jpg';
