              <source type="image/avif" srcset={hospPic.avif} sizes="225px">
              <source type="image/webp" srcset={hospPic.webp} sizes="225px">
              <img src={hospPic.jpg} width="480" height="640" alt="Arabic coffee dallah, dates, guestbook and ceremonial satin ribbon prepared for guests" loading="eager" decoding="async">
            </picture>
